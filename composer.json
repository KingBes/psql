{
    "name": "kingbes/psql",
    "description": "一个 php sql插件，实现sql本地化。",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.2"
    },
    "autoload": {
        "psr-4": {
            "Kingbes\\Psql\\": "src/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.2"
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress --memory-limit=1G",
        "bench": "php bench.php"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
